<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="unqualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="pet">
        <xs:complexType>
            <xs:all>
                <xs:element name="name"/>
                <xs:element name="price"/>
                <xs:element name="age"/>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>